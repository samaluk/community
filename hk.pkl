amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"

min_hk_version = "2.0.1"

default_branch = "master"

exclude = List("node_modules", ".next", "dist", "build", "coverage", ".vercel", ".fallow")

// Staged-file lint/format steps: hk filters staged files through these globs and
// runs the command only on the matches, so an untouched part of the tree never
// gets linted. Pre-commit re-stages fixes; `hk fix` requires --stage to do so.
local web_sources = List(
  "apps/web/**/*.ts",
  "apps/web/**/*.tsx",
  "apps/web/**/*.js",
  "apps/web/**/*.jsx",
  "apps/web/**/*.mjs",
  "apps/web/**/*.cjs",
)

local fixers = new Mapping<String, Step> {
  // exclusive = true serializes the mutating fixers (definition order:
  // oxlint → oxlint-tailwind → oxfmt). v2 file locks prevent overlapping
  // writes; exclusivity also preserves this order before repo-wide gates.
  ["oxlint"] {
    glob = web_sources
    exclusive = true
    // `--no-error-on-unmatched-pattern`: --ignore-path can filter out every
    // staged file (e.g. a commit touching only vendored ui/** components);
    // oxlint would otherwise exit 1 with "No files found to lint".
    check = "pnpm exec oxlint {{files}} --ignore-path .oxlintignore --no-error-on-unmatched-pattern"
    fix = "pnpm exec oxlint --fix {{files}} --ignore-path .oxlintignore --no-error-on-unmatched-pattern"
    output_summary = "combined"
  }
  ["oxlint-tailwind"] {
    glob = web_sources
    exclusive = true
    check = "pnpm exec oxlint {{files}} --config .oxlintrc.tailwind.json --ignore-path .oxlintignore --no-error-on-unmatched-pattern"
    fix = "pnpm exec oxlint --fix {{files}} --config .oxlintrc.tailwind.json --ignore-path .oxlintignore --no-error-on-unmatched-pattern"
    output_summary = "combined"
  }
  ["oxfmt"] {
    glob = web_sources
    exclusive = true
    // `--no-error-on-unmatched-pattern`: oxfmt's own ignorePatterns can
    // exclude every staged file (vendored ui/**, migrations/**); oxfmt would
    // otherwise exit non-zero with "Expected at least one target file".
    check = "pnpm exec oxfmt --check {{files}} --no-error-on-unmatched-pattern"
    fix = "pnpm exec oxfmt --write {{files}} --no-error-on-unmatched-pattern"
    output_summary = "combined"
  }
}

// Whole-repo gates: no glob, so they always run. They need the full tree, not
// just staged files, so they cannot be file-scoped.
local repo_checks = new Mapping<String, Step> {
  ["typecheck"] {
    check = "pnpm typecheck"
  }
  // Strict staged gate: every finding on a staged hunk fails (--gate all).
  // There is no pre-existing backlog to grandfather (see issue #264).
  ["fallow"] {
    check = "pnpm fallow:staged"
  }
  ["test"] {
    check = "pnpm --filter @community/web test"
  }
}

hooks {
  ["pre-commit"] {
    fix = true // run fix commands (auto-lint, auto-format) instead of check commands
    stage = true // include auto-fixes in the commit
    stash = "git" // keep unstaged work safe while hk fixes and re-stages files
    steps {
      ...fixers
      // wait for the fixers, then gate the fixed tree. React Doctor scans
      // only staged files (--staged exits 0 when nothing in apps/web is
      // staged, e.g. docs-only commits). Strict gate: any diagnostic fails
      // (doctor.config.json sets blocking = "warning").
      ["repo-checks"] = new Group {
        steps {
          ...repo_checks
          ["react-doctor"] {
            check = "pnpm react-doctor:staged"
          }
        }
      }
    }
  }
  ["pre-push"] {
    steps {
      ["check-env"] {
        dir = "apps/web"
        check = #"""test -f .env.local || { echo "pre-push: missing apps/web/.env.local — run: cd apps/web && pnpm env:pull" >&2; exit 1; }"""#
      }
      ["typecheck"] {
        check = "pnpm typecheck"
      }
      // Refresh the local master ref so --scope changed diffs against a
      // current origin/master (never fails the push; offline-tolerant).
      ["fetch"] {
        check = "git fetch origin master || true"
      }
      // Strict React Doctor gate: only new findings vs origin/master fail
      // (--scope changed; existing debt is reported but never blocks),
      // matching CI's scope. doctor.config.json sets blocking = "warning".
      ["react-doctor"] {
        depends = List("fetch")
        check = "pnpm react-doctor:changed"
      }
      ["build"] {
        dir = "apps/web"
        check = "pnpm run build"
        output_summary = "combined"
      }
      // Strict full-repository gate: refresh the local master ref first so
      // react-doctor's changed-scope diff is current (never fails the push;
      // offline-tolerant), then run the FULL fallow scan over fresh coverage.
      // Full scope, because there is no backlog to grandfather (#264).
      ["fallow"] {
        depends = List("fetch")
        check = "pnpm test:coverage && pnpm fallow:ci"
        output_summary = "combined"
      }
    }
  }
  // hk check / hk fix — the same fast suite as a CLI: `hk check` (read-only,
  // default: staged files, --all for the whole tree, --unstaged for working-tree
  // changes), `hk fix` (auto-fixes without staging; --stage opts in).
  // React Doctor and Fallow here are the
  // manual deep checks: full-tree scans (the hook variants are scoped — see
  // above). fallow:ci (the canonical full-scan alias) expects coverage from a
  // prior `pnpm test:coverage`.
  ["check"] {
    steps {
      ...fixers
      ...repo_checks
      ["react-doctor"] {
        check = "pnpm react-doctor:full"
      }
      ["fallow-full"] {
        check = "pnpm test:coverage && pnpm fallow:ci"
        output_summary = "combined"
      }
    }
  }
  ["fix"] {
    fix = true
    stage = false // review fixes before staging, or opt in with --stage
    stash = "git"
    steps = fixers
  }
}
