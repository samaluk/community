{
  "name": "community-platform",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "engines": {
    "node": "24.22.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "pnpm --filter @community/web build",
    "build:production": "pnpm --filter @community/web build:production",
    "dev": "pnpm --filter @community/web dev",
    "fallow": "fallow",
    "fallow:dead-code": "fallow dead-code --fail-on-issues",
    "fallow:dupes": "fallow dupes --fail-on-issues",
    "fallow:health": "fallow health --coverage coverage/coverage-final.json --fail-on-issues",
    "fallow:staged": "git diff --cached --unified=0 --no-ext-diff --src-prefix=a/ --dst-prefix=b/ | fallow audit --diff-stdin && git diff --cached --unified=0 --no-ext-diff --src-prefix=a/ --dst-prefix=b/ | fallow health --complexity --diff-stdin --fail-on-issues",
    "fallow:full": "fallow audit --coverage coverage/coverage-final.json && fallow --coverage coverage/coverage-final.json --fail-on-issues",
    "fallow:ci": "pnpm fallow:full",
    "generate:types": "pnpm --filter @community/web generate:types",
    "react-doctor": "react-doctor apps/web --verbose",
    "react-doctor:staged": "react-doctor apps/web --staged --yes --no-score --blocking warning",
    "react-doctor:changed": "react-doctor apps/web --scope changed --base origin/master --yes --no-score --blocking warning",
    "react-doctor:full": "react-doctor apps/web --scope full --yes --no-score --blocking warning",
    "format": "oxfmt --write apps/web",
    "format:check": "oxfmt --check apps/web",
    "check:lint": "oxlint apps/web --ignore-path .oxlintignore && oxlint apps/web --config .oxlintrc.tailwind.json --ignore-path .oxlintignore",
    "oxlint": "pnpm check:lint",
    "lint:core": "oxlint apps/web --ignore-path .oxlintignore",
    "lint:fix": "oxlint --fix apps/web --ignore-path .oxlintignore && oxlint --fix apps/web --config .oxlintrc.tailwind.json --ignore-path .oxlintignore",
    "lint:fix:core": "oxlint --fix apps/web --ignore-path .oxlintignore",
    "lint:fix:tailwind": "oxlint --fix apps/web --config .oxlintrc.tailwind.json --ignore-path .oxlintignore",
    "lint:tailwind": "oxlint apps/web --config .oxlintrc.tailwind.json --ignore-path .oxlintignore",
    "migrate": "pnpm --filter @community/web migrate",
    "migrate:production": "pnpm --filter @community/web migrate:production",
    "test": "pnpm --filter @community/web test",
    "test:coverage": "pnpm --filter @community/web test:coverage",
    "test:e2e": "pnpm --filter @community/web test:e2e",
    "test:int": "pnpm --filter @community/web test:int",
    "test:unit": "pnpm --filter @community/web test:unit",
    "typecheck": "pnpm --filter @community/web typecheck"
  },
  "devDependencies": {
    "@shadcn/lint": "0.2.3",
    "fallow": "3.35.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tailwindcss": "1.16.0",
    "oxlint-tsgolint": "7.0.2005",
    "react-doctor": "0.9.18"
  }
}
