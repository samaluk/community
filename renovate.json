{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":enableVulnerabilityAlerts",
    "helpers:pinGitHubActionDigests"
  ],
  "rangeStrategy": "pin",
  "separateMajorMinor": true,
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 3,
  "timezone": "UTC",
  "schedule": ["before 05:00 on Monday"],
  "packageRules": [
    {
      "description": "Group GitHub Actions updates while retaining digest pinning",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    },
    {
      "description": "Keep the Fallow package and GitHub Action together",
      "matchPackageNames": ["fallow", "fallow-rs/fallow"],
      "groupName": "Fallow",
      "groupSlug": "fallow"
    },
    {
      "description": "Keep lint and formatting tools moving together",
      "matchPackageNames": [
        "oxfmt",
        "oxlint",
        "oxlint-tailwindcss",
        "oxlint-tsgolint",
        "@shadcn/lint"
      ],
      "groupName": "Lint and format tooling",
      "groupSlug": "lint-format-tooling"
    },
    {
      "description": "Keep test and coverage tooling moving together",
      "matchPackageNames": [
        "vitest",
        "@vitest/coverage-v8",
        "@vitejs/plugin-react",
        "vite"
      ],
      "groupName": "Test and coverage tooling",
      "groupSlug": "test-coverage-tooling"
    },
    {
      "description": "Keep Next.js and its Playwright adapter aligned",
      "matchPackageNames": ["next", "@next/playwright"],
      "groupName": "Next.js tooling",
      "groupSlug": "next-tooling"
    },
    {
      "description": "Keep Pullfrog on major-version tags",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["pullfrog/pullfrog"],
      "pinDigests": false,
      "rangeStrategy": "replace"
    }
  ]
}
